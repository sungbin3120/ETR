{
  "name": "korean-number-calculator-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:android": "npm run build && npx cap sync android",
    "android:debug": "cd android && gradlew.bat assembleDebug",
    "android:bundle": "cd android && gradlew.bat bundleRelease",
